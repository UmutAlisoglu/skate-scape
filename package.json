{
  "name": "skate-scape",
  "version": "0.0.1",
  "description": "Unofficial THPS-meets-skate. fan game in the 2009 RuneScape world, in the browser.",
  "license": "AGPL-3.0-only",
  "author": "Umut Alisoglu <umut@alisoglu.com> (https://alisoglu.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/UmutAlisoglu/skate-scape.git"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "node tools/play.mjs",
    "build": "tsc --noEmit && vite build",
    "export:world": "tsx tools/export-area.ts",
    "export:player": "tsx tools/export-player.ts",
    "export:npcs": "tsx tools/export-npcs.ts",
    "export:surfaces": "tsx tools/export-surfaces.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "seek-bzip": "^2.0.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
